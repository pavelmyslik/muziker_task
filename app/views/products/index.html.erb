<h1>Produkty</h1>

<table>
  <thead>
    <tr><th>Název</th><th>Cena</th><th>Dostupnost</th></tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= link_to product.name, product %></td>
        <td><%= number_to_currency(product.price) %></td>
        <td><%= product.stock.positive? ? "Skladem #{product.stock} ks" : "Vyprodáno" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

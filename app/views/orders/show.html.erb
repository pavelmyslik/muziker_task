<div class="alert alert--success">
  <strong>Děkujeme za objednávku!</strong> Číslo objednávky: <%= @order.id %>
</div>

<h1>Souhrn objednávky</h1>

<table class="table">
  <thead>
    <tr><th>Produkt</th><th class="number">Množství</th><th class="number">Cena za kus</th><th class="number">Celkem</th></tr>
  </thead>
  <tbody>
    <% @order.line_items.each do |item| %>
      <tr>
        <td><%= item.product.name %></td>
        <td class="number"><%= item.quantity %></td>
        <td class="number"><%= number_to_currency(item.unit_price) %></td>
        <td class="number"><%= number_to_currency(item.subtotal) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="summary-total"><strong>Celkem: <%= number_to_currency(@order.total) %></strong></p>

<h2>Doručení</h2>
<div class="card">
  <div>
    <%= @order.customer_name %><br>
    <%= @order.street %><br>
    <%= @order.postal_code %> <%= @order.city %>, <%= @order.country %>
  </div>
  <div class="muted"><%= @order.email %> · <%= @order.phone %></div>
</div>

<p><%= link_to "← Zpět na produkty", products_path %></p>

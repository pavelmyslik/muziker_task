<h1>Objednávka</h1>

<% if @error_message %>
  <div class="alert alert--error">
    <strong><%= @error_message %></strong>
    <% if @order.errors.any? %>
      <ul>
        <% @order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<%= form_with model: @order, url: orders_path do |form| %>
  <%= hidden_field_tag :idempotency_key, @idempotency_key %>

  <h2>Produkty</h2>
  <table class="table">
    <thead>
      <tr><th>Název</th><th class="number">Cena</th><th>Dostupnost</th><th>Množství</th></tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= product.name %></td>
          <td class="number"><%= number_to_currency(product.price) %></td>
          <td><%= availability_badge(product) %></td>
          <td>
            <% if product.stock.positive? %>
              <%= hidden_field_tag "items[][product_id]", product.id, id: nil %>
              <%= number_field_tag "items[][quantity]", @quantities[product.id], min: 0, max: 100, id: "quantity_#{product.id}", class: "quantity-input" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h2>Doručovací údaje</h2>
  <div class="form-grid">
    <div class="field"><%= form.label :customer_name, "Jméno a příjmení" %><%= form.text_field :customer_name, required: true %></div>
    <div class="field"><%= form.label :email, "E-mail" %><%= form.email_field :email, required: true %></div>
    <div class="field"><%= form.label :phone, "Telefon" %><%= form.telephone_field :phone, required: true %></div>
    <div class="field"><%= form.label :street, "Ulice a číslo" %><%= form.text_field :street, required: true %></div>
    <div class="field"><%= form.label :city, "Město" %><%= form.text_field :city, required: true %></div>
    <div class="field"><%= form.label :postal_code, "PSČ" %><%= form.text_field :postal_code, required: true %></div>
    <div class="field"><%= form.label :country, "Země" %><%= form.select :country, [ [ "Česko", "CZ" ], [ "Slovensko", "SK" ] ] %></div>
  </div>

  <div class="form-actions">
    <%= form.submit "Objednat" %>
  </div>
<% end %>
